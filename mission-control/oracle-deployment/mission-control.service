[Unit]
Description=Mission Control - Unified Collaboration Platform
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/mission-control
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=3000

# Memory limits for Oracle Cloud free tier (6GB)
MemoryMax=4G
MemoryHigh=3G

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
